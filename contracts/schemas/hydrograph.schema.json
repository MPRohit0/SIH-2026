{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sih26161.org/hydrograph.schema.json",
  "title": "Discharge Series",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "hydrograph_id": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "t_min": {
            "type": "number",
            "minimum": 0
          },
          "discharge_m3s": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["t_min", "discharge_m3s"]
      }
    }
  },
  "required": ["points"],
  "oneOf": [
    {"required": ["series_id"]},
    {"required": ["hydrograph_id"]}
  ]
}
