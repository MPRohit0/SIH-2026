# ==============================================================================
# SIH26161 Environment Configuration Example
# Copy this file to .env and configure local/environment-specific settings.
# Never commit the .env file containing real keys or secrets.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local Storage Root (Defaults to repository data/ directory if left empty)
DATA_ROOT=

# Google Earth Engine (Module 7 Satellite Assimilation)
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_PATH=

# External Hydrodynamic Solvers Paths (M3 & M4)
# Specify paths to locally compiled executable binaries
DELFT3D_PATH=
DUALSPHYSICS_PATH=
